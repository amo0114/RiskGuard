# Risk Guard Environment Configuration Template
# Copy this file to .env or inject these variables into your container environment.

# Port and binding settings (default loopback)
RG_LISTENER=127.0.0.1:4100
RG_ADMIN_LISTENER=127.0.0.1:4101
RG_UPSTREAM=http://127.0.0.1:4000

# Paths
RG_CONFIG_PATH=/etc/riskguard/config.yaml
RG_POLICY_PATH=/etc/riskguard/policy-v1.yaml
RG_SPOOL_DIR=/var/lib/riskguard/spool

# Credentials and Keys (Never commit real values)
# RG_HMAC_KEY_FILE=/etc/riskguard/hmac.key
# RG_GUARD_KEY_FILE=/etc/riskguard/guard.key
# RG_CONSOLE_TOKEN_FILE=/etc/riskguard/console.token
